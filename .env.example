# Host used to build absolute URLs (routes + mailers)
RAILS_DEFAULT_HOST=localhost:3000

# Basic auth for the GoodJob dashboard mounted at /good_job (both are required)
GOOD_JOB_USERNAME=
GOOD_JOB_PASSWORD=

# Active Storage — Scaleway Object Storage (S3 compatible)
SCALEWAY_ACCESS_KEY_ID=
SCALEWAY_ACCESS_KEY_SECRET=
SCALEWAY_BUCKET_NAME=
SCALEWAY_ENDPOINT=
SCALEWAY_REGION=

# Sender address used by Devise mailers
SMTP_FROM=

# API key for the `vat_rates:fetch` rake task
VAT_LAYER_API_KEY=
